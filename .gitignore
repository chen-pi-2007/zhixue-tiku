# 临时文件
tmp/
__pycache__/
*.pyc
*.bak

# 用户自己的数据：做题记录、练习文件、备份 —— 绝不上传
data/progress.json
data/progress.json.*
data/skill_work/
data/_备份_*/
data/*.corrupt
data/*.tmp
data/*备份*

# 本机配置（可能填了大模型 API Key），模板见 config.example.json
config.json

# 打包产物（exe 发布到 GitHub Releases）
_build/
*.exe
server.log
data/data_version.txt

# 热更新下载的内容（content/current、content/next）
content/

# 独立窗口（WebView2）的本地存储：主题、翻译开关等
webview/
